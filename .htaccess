<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block access to hidden/system files and directories
    RewriteRule ^(\.env|\.git|\.editorconfig|\.gitattributes|\.gitignore) - [F,L,NC]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js) - [F,L,NC]
    RewriteRule ^(app|bootstrap|config|database|deploy|docs|resources|routes|storage|tests|vendor)/ - [F,L,NC]

    # Rewrite all traffic into the public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
