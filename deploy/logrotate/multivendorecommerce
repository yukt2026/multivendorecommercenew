# ==============================================================================
# OneStall Marketplace — Logrotate Configuration
# Path: /etc/logrotate.d/multivendorecommerce
# ==============================================================================

# 1. Laravel Application & Daemon Logs
/var/www/multivendorecommerce/current/storage/logs/*.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    copytruncate
    su www-data www-data
    create 0664 www-data www-data
}

# 2. Production Nginx Access & Error Logs
/var/log/nginx/onestall_access.log
/var/log/nginx/onestall_error.log {
    daily
    missingok
    rotate 30
    compress
    delaycompress
    notifempty
    sharedscripts
    postrotate
        [ -f /var/run/nginx.pid ] && kill -USR1 $(cat /var/run/nginx.pid)
    endscript
}

# 3. Database Backup & Restore Logs
/var/log/onestall_backup.log
/var/log/onestall_restore_test.log {
    weekly
    missingok
    rotate 12
    compress
    delaycompress
    notifempty
    copytruncate
}
