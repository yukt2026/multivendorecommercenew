# ==============================================================================
# OneStall Marketplace — Production Environment Configuration (.env.production)
# ==============================================================================
# IMPORTANT: Never commit actual secret keys or credentials to version control.
# Copy this template to .env on the production server and populate values securely.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME="OneStall"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://onestall.in
APP_TIMEZONE=Asia/Kolkata
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Force HTTPS & Canonical Host
FORCE_HTTPS=true
ASSET_URL=https://onestall.in

# ------------------------------------------------------------------------------
# 2. LOGGING & ERROR MONITORING (SENTRY)
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily,sentry
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# Sentry Production Error Tracking
SENTRY_LARAVEL_DSN=https://your-sentry-key@o123456.ingest.sentry.io/7890123
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (PRIMARY & REPLICA)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=onestall_prod
DB_USERNAME=onestall_app
DB_PASSWORD=YOUR_STRONG_DATABASE_PASSWORD_HERE
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Optional Read Replica (uncomment when database replication is enabled)
# DB_READ_HOST=10.0.1.20

# ------------------------------------------------------------------------------
# 4. REDIS CLUSTER / CACHE / SESSION / QUEUE
# ------------------------------------------------------------------------------
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

QUEUE_CONNECTION=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=YOUR_STRONG_REDIS_PASSWORD_HERE
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX="onestall_prod_"

# ------------------------------------------------------------------------------
# 5. STORAGE & ASSET PIPELINE (AWS S3 / CLOUDFLARE R2)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=s3
PRIVATE_DISK_DRIVER=s3

# Public Media Bucket (Products, Banners, Store Logos)
AWS_ACCESS_KEY_ID=YOUR_S3_OR_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=YOUR_S3_OR_R2_SECRET_KEY
AWS_DEFAULT_REGION=auto
AWS_BUCKET=onestall-public-media
AWS_URL=https://media.onestall.in
AWS_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_USE_PATH_STYLE_ENDPOINT=false

# Private KYC & Documents Bucket (PAN, GST, Bank Cheques, Contracts)
AWS_PRIVATE_ACCESS_KEY_ID=YOUR_S3_OR_R2_ACCESS_KEY
AWS_PRIVATE_SECRET_ACCESS_KEY=YOUR_S3_OR_R2_SECRET_KEY
AWS_PRIVATE_DEFAULT_REGION=auto
AWS_PRIVATE_BUCKET=onestall-private-kyc
AWS_PRIVATE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_PRIVATE_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 6. REALTIME WEBSOCKETS (LARAVEL REVERB)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=100101
REVERB_APP_KEY=onestall_live_reverb_key_99
REVERB_APP_SECRET=onestall_live_reverb_secret_88
REVERB_HOST="onestall.in"
REVERB_PORT=443
REVERB_SCHEME="https"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ------------------------------------------------------------------------------
# 7. PAYMENT GATEWAYS (PRODUCTION KEYS)
# ------------------------------------------------------------------------------
# Razorpay Production
RAZORPAY_KEY=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx

# Cashfree Production
CASHFREE_APP_ID=CF_PROD_xxxxxxxxxxxx
CASHFREE_SECRET_KEY=cfsk_ma_prod_xxxxxxxxxxxxxxxxxxxxxxxx
CASHFREE_API_VERSION=2023-08-01
CASHFREE_IS_SANDBOX=false

# ------------------------------------------------------------------------------
# 8. LOGISTICS (ONESTALL CARGO INTEGRATION)
# ------------------------------------------------------------------------------
CARGO_API_URL=https://api.cargo.onestall.in/v1
CARGO_CLIENT_ID=os_cargo_live_client_xxxxxxxx
CARGO_CLIENT_SECRET=os_cargo_live_secret_xxxxxxxx
CARGO_WEBHOOK_SECRET=os_cargo_wh_live_xxxxxxxx
CARGO_TIMEOUT=15
CARGO_USE_FAKES=false

# ------------------------------------------------------------------------------
# 9. TRANSACTIONAL EMAIL (POSTMARK / AWS SES / RESEND)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.postmarkapp.com
MAIL_PORT=587
MAIL_USERNAME=YOUR_POSTMARK_SERVER_API_TOKEN
MAIL_PASSWORD=YOUR_POSTMARK_SERVER_API_TOKEN
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="orders@onestall.in"
MAIL_FROM_NAME="OneStall Marketplace"

# ------------------------------------------------------------------------------
# 10. SMS & WHATSAPP CHANNELS (PRODUCTION)
# ------------------------------------------------------------------------------
SMS_GATEWAY_DRIVER=msg91
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY
MSG91_SENDER_ID=ONESTL
MSG91_TEMPLATE_ID_OTP=6510f823...

WHATSAPP_GATEWAY_DRIVER=gupshup
GUPSHUP_APP_NAME=OneStallAlerts
GUPSHUP_API_KEY=YOUR_GUPSHUP_API_KEY
GUPSHUP_SRC_PHONE=919876543210

# Push Driver (Firebase Cloud Messaging)
PUSH_GATEWAY_DRIVER=fcm
FCM_SERVER_KEY=YOUR_FIREBASE_FCM_KEY

# ------------------------------------------------------------------------------
# 11. MARKETPLACE DEFAULTS & LIMITS
# ------------------------------------------------------------------------------
ONESTALL_ORDER_PREFIX=OS-
DEFAULT_COMMISSION_PCT=10.00
MAX_COD_AMOUNT=5000.00
RETURN_WINDOW_DAYS=7
DEFAULT_DELIVERY_RADIUS_KM=10.0
ENABLE_HORIZON=true
HORIZON_PREFIX=onestall_horizon:
